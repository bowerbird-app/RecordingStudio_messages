<%= turbo_stream.replace messages_panel_list_id(@group_recording) do %>
  <%= render "recording_studio_messages/message_groups/message_list",
             group_recording: @group_recording,
             message_recordings: @message_recordings,
             current_actor: current_messages_actor %>
<% end %>

<%= turbo_stream.replace messages_panel_composer_id(@group_recording) do %>
  <%= render "recording_studio_messages/message_groups/composer",
             group_recording: @group_recording,
             form_url: messages_panel_form_url(@group_recording),
             return_to: params[:return_to].presence || message_group_path(@group_recording) %>
<% end %>
