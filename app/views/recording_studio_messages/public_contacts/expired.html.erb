<%= render layout: "recording_studio_messages/public_contacts/step" do %>
  <h1 class="text-xl font-semibold">Check your email</h1>
  <p>That contact form expired. Send it again.</p>
  <%= render FlatPack::Button::Component.new(
    text: "Send it again",
    href: public_contact_restart_path(@intent.mount_recording_id),
    style: :primary,
    size: :md,
    class: "w-full",
    data: { turbo_frame: public_contact_frame_id }
  ) %>
<% end %>
