<% content_for :title, messages_t("contact.sent_title") %>
<%= render layout: "recording_studio_messages/public_contacts/step" do %>
  <div class="flex flex-col items-center gap-3 text-center" data-public-contact-step="sent">
    <% sent_icon = public_contact_sent_icon %>
    <% if sent_icon && public_contact_sent_image?(sent_icon) %>
      <%= tag.img(
        src: sent_icon,
        alt: "",
        class: "block h-8 w-8 shrink-0 object-contain"
      ) %>
    <% elsif sent_icon %>
      <%= render FlatPack::Shared::IconComponent.new(
        name: sent_icon,
        size: :xl,
        class: "text-[var(--surface-muted-content-color)]"
      ) %>
    <% end %>
    <h1 class="text-3xl font-semibold"><%= messages_t("contact.sent_title") %></h1>
    <% credit = public_contact_powered_by(@group_recording) %>
    <% if credit.present? %>
      <p><%= credit %></p>
    <% end %>
    <% sent_href = public_contact_sent_button_href(@group_recording) %>
    <% if sent_href %>
      <%= render FlatPack::Button::Component.new(
        text: public_contact_sent_button_label,
        href: sent_href,
        style: :primary,
        size: :md,
        class: "w-full",
        data: public_contact_sent_button_data
      ) %>
    <% end %>
  </div>
<% end %>
