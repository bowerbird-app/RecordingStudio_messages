<% mount = local_assigns.fetch(:mount) %>
<% title = local_assigns[:title].presence || messages_t("contact.title") %>
<% introduction = local_assigns[:introduction] %>
<% submit_label = local_assigns[:submit_label].presence || messages_t("contact.submit") %>
<% heading = local_assigns.fetch(:heading, true) %>
<% actor = public_contact_actor %>

<% if heading %>
  <h1 class="text-xl font-semibold"><%= title %></h1>
<% end %>
<% if introduction.present? %>
  <p><%= introduction %></p>
<% end %>

<%= form_with url: public_contact_submit_path(mount), method: :post, **public_contact_form_options do %>
  <%= public_contact_modal_fields(introduction: introduction, submit_label: submit_label) %>
  <div class="space-y-4">
    <% if actor %>
      <% if actor.respond_to?(:name) && actor.name.present? %>
        <%= render FlatPack::Badge::Component.new(text: actor.name, size: :sm) %>
      <% end %>
    <% else %>
      <%= render FlatPack::TextInput::Component.new(
        **public_contact_input(:name, name: "name", label: messages_t("contact.name"), required: true, maxlength: 120, autocomplete: "name")
      ) %>
      <%= render FlatPack::EmailInput::Component.new(
        **public_contact_input(:email, name: "email", label: messages_t("contact.email"), required: true, autocomplete: "email")
      ) %>
    <% end %>
    <%= render FlatPack::TextArea::Component.new(
      **public_contact_input(:body, name: "body", label: messages_t("contact.body"), required: true, rows: 5)
    ) %>
    <%= render FlatPack::Button::Component.new(text: submit_label, style: :primary, size: :md, type: "submit", class: "w-full") %>
  </div>
<% end %>
