<% if turbo_frame_request? %>
  <%= render "recording_studio_messages/message_groups/panel_frame",
             group_recording: @group_recording,
             message_recordings: @message_recordings,
             current_actor: current_messages_actor %>
<% else %>
  <% content_for :title, @group_recording.recordable.title %>
  <% flat_pack_page_nav(
       round: true,
       style: :default,
       back_href: message_groups_path(mount_id: @mount_recording&.id),
       back_tooltip: messages_inbox_title(@mount_recording),
       anchor_href: main_app.root_path
     ) %>

  <%= render "recording_studio_messages/message_groups/desk",
             group_recordings: @group_recordings,
             group_recording: @group_recording,
             message_recordings: @message_recordings,
             current_actor: current_messages_actor %>
<% end %>
