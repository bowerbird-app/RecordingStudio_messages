<% group_recording = local_assigns.fetch(:group_recording) %>
<% form_url = local_assigns[:form_url].presence || messages_panel_form_url(group_recording) %>
<% return_to = local_assigns[:return_to].presence || messages_panel_return_to %>

<%= form_with url: form_url,
              method: :post,
              local: true,
              multipart: true,
              html: { id: messages_panel_composer_id(group_recording) },
              data: { controller: "flat-pack--chat-sender", turbo_stream: true } do %>
  <%= hidden_field_tag :return_to, return_to %>
  <%= file_field_tag "message[files][]",
        multiple: true,
        accept: "image/*,application/pdf,text/plain",
        class: "hidden",
        data: { flat_pack__chat_sender_target: "fileInput" } %>
  <%= render FlatPack::Chat::Composer::Component.new do |composer| %>
    <% composer.left do %>
      <%= render FlatPack::Button::Dropdown::Component.new(
        text: "",
        icon: "plus",
        style: :ghost,
        size: :md,
        show_chevron: false,
        placement: :top_left,
        trigger_attributes: {
          aria: { label: "Add a file" },
          title: "Add a file"
        }
      ) do |dropdown| %>
        <% dropdown.menu_item(
          text: "Upload files or images",
          icon: "file",
          type: "button",
          data: { action: "click->flat-pack--chat-sender#openFilePicker" }
        ) %>
      <% end %>
    <% end %>
    <% composer.center do %>
      <%= render FlatPack::TextArea::Component.new(
        name: "message[body]",
        rows: 1,
        autogrow: true,
        submit_on_enter: true,
        placeholder: "Write a message",
        class: "min-h-[var(--chat-composer-control-height)] max-h-32 rounded-lg border-[var(--chat-input-border-color)] bg-[var(--chat-input-background-color)] px-4 py-[var(--chat-composer-control-padding-y)] text-sm leading-5 text-[var(--chat-input-text-color)] placeholder:text-[var(--chat-input-placeholder-color)] focus:ring-[var(--chat-input-focus-ring-color)]"
      ) %>
    <% end %>
  <% end %>
<% end %>
