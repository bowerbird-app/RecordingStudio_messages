<% mount_recording = local_assigns.fetch(:mount_recording) %>
<% modal_id = messages_new_conversation_modal_id(mount_recording) %>
<% frame_id = messages_new_conversation_frame_id(mount_recording) %>

<%= render FlatPack::Modal::Component.new(
  id: modal_id,
  title: messages_t("inbox.new"),
  size: :md
) do |modal| %>
  <% modal.body do %>
    <div class="flex flex-col gap-4"
         data-controller="recording-studio-messages--new-conversation">
      <%= turbo_frame_tag frame_id,
            src: messages_contacts_path(mount_recording),
            loading: :lazy %>
      <%= form_with url: messages_create_conversation_path,
                    method: :post,
                    local: true,
                    html: { class: "flex flex-col gap-4" } do %>
        <%= hidden_field_tag :mount_id, mount_recording.id %>
        <div class="flex flex-wrap gap-2 empty:hidden"
             data-recording-studio-messages--new-conversation-target="recipients"></div>
        <%= render FlatPack::TextInput::Component.new(
          name: "title",
          label: messages_t("inbox.title_optional"),
          maxlength: RecordingStudioMessages::MessageGroup::TITLE_MAX
        ) %>
        <%= render FlatPack::TextArea::Component.new(
          name: "body",
          label: messages_t("contact.body"),
          required: true,
          rows: 4,
          placeholder: messages_t("composer.placeholder")
        ) %>
        <%= render FlatPack::Button::Component.new(
          text: messages_t("inbox.new"),
          style: :primary,
          size: :md,
          type: "submit"
        ) %>
      <% end %>
      <template data-recording-studio-messages--new-conversation-target="chipTemplate">
        <%= render FlatPack::Chip::Component.new(
          text: "__TITLE__",
          removable: true,
          size: :sm
        ) %>
      </template>
    </div>
  <% end %>
<% end %>
