<% group_recordings = local_assigns.fetch(:group_recordings) %>
<% inbox_title = local_assigns[:title].presence || messages_inbox_title(local_assigns[:mount_recording]) %>
<% inbox_rows = messages_inbox_rows(group_recordings) %>

<%= render FlatPack::PageTitle::Component.new(title: inbox_title, variant: :h1) %>

<% if inbox_rows.blank? %>
  <%= render FlatPack::Chat::SystemMessage::Component.new do %>
    Nothing here yet.
  <% end %>
<% else %>
  <div class="w-full max-w-2xl">
    <%= render FlatPack::List::Component.new(spacing: :dense, selectable: true) do %>
      <% inbox_rows.each do |inbox_row| %>
        <%= render FlatPack::Chat::InboxRow::Component.new(**inbox_row) %>
      <% end %>
    <% end %>
  </div>
<% end %>
