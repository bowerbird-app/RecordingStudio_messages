<% current_actor = local_assigns.fetch(:current_actor) %>
<% group_recording = local_assigns.fetch(:group_recording) %>
<% message_recordings = local_assigns.fetch(:message_recordings) %>
<% latest_message = message_recordings.last %>
<% seen_by = message_seen_by(
     group_recording,
     viewer: current_actor,
     latest_message: latest_message
   ) %>

<%= render FlatPack::Chat::MessageList::Component.new(
  stick_to_bottom: true,
  id: messages_panel_list_id(group_recording)
) do %>
  <% if message_recordings.empty? %>
    <%= render FlatPack::Chat::SystemMessage::Component.new do %>
      <%= messages_t("inbox.empty_thread") %>
    <% end %>
  <% else %>
    <% previous = nil %>
    <% message_recordings.each do |message_recording| %>
      <% if message_day_break?(previous, message_recording) %>
        <%= render FlatPack::Chat::DateDivider::Component.new(label: message_day_label(message_timestamp(message_recording).to_date)) %>
      <% elsif message_time_break?(previous, message_recording) %>
        <%= render FlatPack::Chat::DateDivider::Component.new(label: message_clock(message_recording)) %>
      <% end %>
      <%= render "recording_studio_messages/message_groups/message",
                 message_recording: message_recording,
                 current_actor: current_actor,
                 last_message: message_recording == latest_message,
                 readers: message_recording == latest_message ? seen_by : [] %>
      <% previous = message_recording %>
    <% end %>
  <% end %>
<% end %>
