<% message_recording = local_assigns.fetch(:message_recording) %>
<% current_actor = local_assigns.fetch(:current_actor) %>
<% readers = local_assigns[:readers] || [] %>
<% last_message = local_assigns.fetch(:last_message, false) %>
<% reference_slots = Array(local_assigns[:visible_references]) %>
<% sender = message_sender_for(message_recording) %>
<% outgoing = outgoing_message?(message_recording, actor: current_actor) %>
<% direction = outgoing ? :outgoing : :incoming %>
<% sender_name = message_sender_name(sender) %>
<% bubble = outgoing ? FlatPack::Chat::SentMessage::Component : FlatPack::Chat::ReceivedMessage::Component %>
<% attachments = message_attachments_for(message_recording) %>
<% sent_at = message_timestamp(message_recording) %>
<% body_text = message_recording.recordable&.body.to_s %>
<% show_bubble = body_text.present? || attachments.any? %>

<div
  class="transition-[margin] duration-base"
  data-flat-pack-chat-record="true"
  data-flat-pack-chat-record-sender="<%= sender_name %>"
  data-flat-pack-chat-record-direction="<%= direction %>"
>
  <%= render FlatPack::Chat::MessageGroup::Component.new(
    direction: direction,
    show_avatar: !outgoing,
    show_name: !outgoing,
    sender_name: sender_name
  ) do |group| %>
    <% unless outgoing %>
      <% group.avatar do %>
        <%= render FlatPack::Avatar::Component.new(name: sender_name, size: :sm) %>
      <% end %>
    <% end %>
    <% if show_bubble %>
      <% group.message do %>
        <%= render bubble.new(
          timestamp: sent_at,
          reveal_timestamp: true
        ) do |message| %>
          <% attachments.each do |attachment_recording| %>
            <% attachment = attachment_recording.recordable %>
            <% next if attachment.blank? %>
            <% if attachment.attachment_kind.to_s == "image" %>
              <% message.media_attachment do %>
                <%= render FlatPack::Chat::Attachment::Component.new(
                  name: attachment.name,
                  type: :image,
                  meta: attachment.original_filename,
                  href: message_attachment_href(attachment_recording),
                  thumbnail_url: message_attachment_thumbnail(attachment_recording)
                ) %>
              <% end %>
            <% else %>
              <% message.attachment do %>
                <%= render FlatPack::Chat::Attachment::Component.new(
                  name: attachment.name,
                  type: :file,
                  meta: attachment.original_filename,
                  href: message_attachment_href(attachment_recording)
                ) %>
              <% end %>
            <% end %>
          <% end %>
          <%= linked_message_body(body_text) %>
        <% end %>
      <% end %>
    <% end %>
    <% reference_slots.each do |slot| %>
      <% group.message do %>
        <%= render "recording_studio_messages/message_groups/reference_card",
                   slot: slot,
                   direction: direction %>
      <% end %>
    <% end %>
    <% if last_message %>
      <% group.status do %>
        <% if readers.any? %>
          <%= render "recording_studio_messages/message_groups/message_seen",
                     message_recording: message_recording,
                     actors: readers,
                     outgoing: outgoing %>
        <% else %>
          <%= render FlatPack::Chat::SentAt::Component.new(timestamp: sent_at) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
