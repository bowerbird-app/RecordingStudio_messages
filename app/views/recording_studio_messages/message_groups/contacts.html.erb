<% frame_id = messages_new_conversation_frame_id(@mount_recording) %>
<%= turbo_frame_tag frame_id do %>
  <% if @query.to_s.strip.blank? %>
  <% elsif @contacts.empty? %>
    <%= render FlatPack::Text::Component.new(text: messages_t("inbox.no_people"), size: :sm) %>
  <% else %>
    <%= render FlatPack::List::Component.new(
      spacing: :dense,
      selectable: true,
      class: "max-h-48 overflow-y-auto rounded-[var(--dropdown-item-radius)] border border-[var(--surface-border-color)] bg-[var(--surface-background-color)] p-[var(--combobox-menu-padding)]"
    ) do %>
      <% @contacts.each do |actor| %>
        <% name = message_sender_name(actor) %>
        <%= render FlatPack::List::Item.new(
          title: name,
          hover: true,
          leading: render(FlatPack::Avatar::Component.new(name: name, size: :sm, shape: :circle)),
          data: {
            action: "click->recording-studio-messages--new-conversation#add",
            type: actor.class.name,
            id: actor.id,
            name: name,
            contact_key: "#{actor.class.name}:#{actor.id}"
          }
        ) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
