<% current_actor = local_assigns.fetch(:current_actor) %>
<% group_recordings = local_assigns.fetch(:group_recordings) %>
<% selected_group = local_assigns[:group_recording] %>
<% message_recordings = local_assigns[:message_recordings] %>
<% inbox = local_assigns[:inbox] %>
<% unread_filter = local_assigns[:unread_filter] %>
<% inbox_rows = messages_inbox_rows(group_recordings, selected: selected_group, inbox: inbox) %>
<%# Fill the viewport under the host's page nav so the composer sits on the bottom edge. %>
<% desk_height_class = local_assigns[:desk_height_class].presence || "h-[calc(100dvh-15.5rem)]" %>

<%# Chat::Layout is h-full. w-full min-w-0 lets the fluid split shrink inside core main.
    Do not fork Layout's split CSS. Layout's stacked Back to conversations stays
    visible so a stacked window can return to the list without leaving the desk. %>
<div class="w-full min-w-0 <%= desk_height_class %>">
  <%= render FlatPack::Chat::Layout::Component.new(variant: :split) do |layout| %>
    <% layout.sidebar do %>
      <% if inbox == :my_messages %>
        <%= render FlatPack::Chat::Header::Component.new(title: messages_t("inbox.my_title")) do |header| %>
          <% header.right do %>
            <%= render "recording_studio_messages/message_groups/unread_badge",
                       unread_count: messages_unread_count %>
            <%= render FlatPack::Button::Component.new(**messages_unread_filter_button(unread_filter: unread_filter)) %>
          <% end %>

        <% end %>
      <% end %>
      <%= render FlatPack::List::Component.new(spacing: :dense, selectable: true) do %>
        <% inbox_rows.each do |inbox_row| %>
          <%= turbo_frame_tag inbox_row[:title_frame_id] do %>
            <%= render FlatPack::Chat::InboxRow::Component.new(**inbox_row.except(:title_frame_id)) %>
          <% end %>
        <% end %>
        <% if local_assigns[:older_href].present? %>
          <%= render FlatPack::Button::Component.new(
                text: messages_t("inbox.older"),
                href: local_assigns[:older_href],
                style: :secondary,
                size: :sm
              ) %>
        <% end %>
      <% end %>
    <% end %>

    <% layout.panel do %>
      <%= render "recording_studio_messages/message_groups/panel_frame",
                 group_recording: selected_group,
                 message_recordings: message_recordings,
                 current_actor: current_actor,
                 form_url: local_assigns[:form_url],
                 return_to: local_assigns[:return_to],
                 inbox: inbox %>
    <% end %>
  <% end %>
</div>
