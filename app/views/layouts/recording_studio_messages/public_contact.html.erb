<!DOCTYPE html>
<html <%= tag.attributes(public_contact_document_attributes) %>>
  <head>
    <title><%= content_for(:title) || messages_t("contact.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/rich_text", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-[var(--surface-page-background-color)] text-[var(--surface-content-color)]">
    <% if respond_to?(:recording_studio_language_selector) %>
      <div class="absolute right-4 top-4">
        <%= public_contact_language_selector %>
      </div>
    <% end %>
    <main class="flex min-h-dvh items-center justify-center p-6">
      <div class="w-full max-w-sm space-y-4">
        <% if flash[:notice].present? %>
          <%= render FlatPack::Alert::Component.new(description: flash[:notice], style: :success) %>
        <% end %>
        <% if flash[:alert].present? %>
          <%= render FlatPack::Alert::Component.new(description: flash[:alert], style: :danger) %>
        <% end %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
