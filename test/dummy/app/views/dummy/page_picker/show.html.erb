<% frame_id = "messages-composer-action-attach_page-frame" %>
<%= turbo_frame_tag frame_id do %>
  <div class="flex flex-col gap-2" data-controller="page-picker">
    <%= form_with url: dummy_page_picker_path, method: :get, local: false,
                  html: { data: { turbo_frame: frame_id, action: "input->page-picker#search" } } do %>
      <%= hidden_field_tag :mount_id, @mount.id %>
      <%= render FlatPack::SearchInput::Component.new(
        name: "q",
        value: @query,
        placeholder: t("dummy.composer.find_a_page")
      ) %>
    <% end %>
    <% if @pages.empty? %>
      <%= render FlatPack::Text::Component.new(text: t("dummy.composer.no_pages"), size: :sm) %>
    <% else %>
      <% @pages.each do |page_recording| %>
        <% title = dummy_page_title(page_recording) %>
        <% url = dummy_page_href(page_recording) %>
        <%= render FlatPack::Button::Component.new(
          text: title,
          style: :secondary,
          size: :md,
          type: :button,
          data: {
            action: "click->page-picker#insert",
            recording_id: page_recording.id,
            title: title,
            url: url
          }
        ) %>
      <% end %>
    <% end %>
  </div>
<% end %>
