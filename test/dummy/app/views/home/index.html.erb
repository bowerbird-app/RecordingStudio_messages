<% recording_studio_page_nav(title: "Dummy host") %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Dummy host",
    subtitle: "Two message desks on one gem. This host is not the product.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-3">
    <%= render FlatPack::Button::Component.new(
      text: "Staff desk",
      href: staff_desk_path,
      style: :primary,
      size: :md
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Inbox",
      href: inbox_path,
      style: :secondary,
      size: :md
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Admin",
      href: recording_studio_admin_admin.root_path,
      style: :secondary,
      size: :md
    ) %>
    <% if @public_contact_mount %>
      <%= render FlatPack::Button::Component.new(
        text: "Contact",
        href: recording_studio_messages.public_contact_path(mount_id: @public_contact_mount.id),
        style: :secondary,
        size: :md
      ) %>
    <% end %>
  </div>
</div>
