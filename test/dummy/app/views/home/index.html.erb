<% content_for :title, t("dummy.home.title") %>
<% content_for :subtitle, t("dummy.home.subtitle") %>
<% flat_pack_page_nav(round: true, style: :default) %>

<div class="flex w-full flex-col gap-6">
  <div class="flex flex-wrap gap-3">
    <%= render FlatPack::Button::Component.new(
      text: t("dummy.home.staff_desk"),
      href: staff_desk_path,
      style: :primary,
      size: :md
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: t("dummy.home.inbox"),
      href: inbox_path,
      style: :secondary,
      size: :md
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: t("dummy.home.my_messages"),
      href: recording_studio_messages.my_messages_path,
      style: :secondary,
      size: :md
    ) %>
    <% if @messages_unread_count.to_i.positive? %>
      <%= render FlatPack::Badge::Component.new(
            text: @messages_unread_count.to_s,
            style: :primary,
            size: :sm
          ) %>
    <% end %>
    <%= render FlatPack::Button::Component.new(
      text: t("dummy.home.admin"),
      href: recording_studio_admin_admin.root_path,
      style: :secondary,
      size: :md
    ) %>
    <% if @public_contact_mount %>
      <%= public_contact_modal(@public_contact_mount) %>
    <% end %>
  </div>
</div>
